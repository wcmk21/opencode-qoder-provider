{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qoder": {
      "name": "Qoder",
      "npm": "opencode-qoder-provider",
      "options": {
        "region": "global"
      }
    },
    "qoder-cn": {
      "name": "Qoder CN",
      "npm": "opencode-qoder-provider",
      "options": {
        "region": "cn"
      }
    }
  },
  "plugin": ["opencode-qoder-provider/plugin"]
}
